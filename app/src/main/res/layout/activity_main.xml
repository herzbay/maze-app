<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mainmaze"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/usernameEditText"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="450dp"
        android:hint="Username"
        android:inputType="text"
        android:maxLines="1"
        android:padding="4dp"
        android:background="@drawable/rounded_text"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:layout_marginBottom="5dp"/>

    <ImageButton
        android:id="@+id/playButton"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:layout_below="@id/usernameEditText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:background="@android:color/transparent"
        android:src="@drawable/icon_play"/> <!-- Replace with your drawable resource -->

    <ImageButton
        android:id="@+id/aboutButton"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:layout_below="@id/playButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:background="@android:color/transparent"
        android:src="@drawable/icon_about"/> <!-- Replace with your drawable resource -->

    <ImageButton
        android:id="@+id/exitButton"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:layout_below="@id/aboutButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:background="@android:color/transparent"
        android:src="@drawable/icon_exit"/> <!-- Replace with your drawable resource -->

</RelativeLayout>
